---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { siteConfig } from '../data/nav';
import { organization, webPageFor, breadcrumbsFor } from '../data/schema';

interface Props {
  title: string;
  description: string;
  path?: string;
  schema?: object | object[];
  ogImage?: string;
  ogTitle?: string;
  ogDescription?: string;
  noindex?: boolean;
}

const { title, description, path = '/', schema, ogImage = `${siteConfig.url}/og-image.jpg`, ogTitle = title, ogDescription = description, noindex = false } = Astro.props;
const canonical = new URL(path, siteConfig.url).toString();
const pageSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const hasType = (t: string) => pageSchema.some((s: any) => s['@type'] === t);
// Every page gets the shared Organization once, plus a WebPage and BreadcrumbList unless the page defines its own.
const schemaList = [
  organization,
  ...pageSchema,
  ...(hasType('WebPage') ? [] : [webPageFor({ name: title, description, url: canonical })]),
  ...(hasType('BreadcrumbList') || path === '/' ? [] : [breadcrumbsFor(path)]),
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="apple-touch-icon" href="/favicon.png?v=2" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    {schemaList.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <a class="wa-float" href="https://wa.me/923198652203?text=Hi%20Huzaifa%20Local%20SEO%2C%20I%20would%20like%20a%20free%20SEO%20audit." target="_blank" rel="noopener" aria-label="Chat with Huzaifa Local SEO on WhatsApp at +92 319 8652203">
      <span class="wa-float-icon" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.6-.8-1.9-.9-.3-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.2.2-.3.2-.5.1-.3-.1-1.2-.4-2.2-1.4-.8-.7-1.4-1.6-1.6-1.9-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.1.2-.3.3-.4.1-.2 0-.3 0-.5 0-.1-.6-1.5-.8-2-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.2s1 2.6 1.1 2.7c.1.2 1.9 3 4.7 4.1.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.6-.1 1.6-.7 1.9-1.3.2-.6.2-1.2.2-1.3-.1-.1-.3-.2-.5-.3z"/><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3.2.8.8-3.1-.2-.3A8.2 8.2 0 1 1 12 20.2z"/></svg>
      </span>
      <span class="wa-float-label">Chat on WhatsApp<small>+92 319 8652203</small></span>
    </a>
  </body>
</html>
