---
import { services, locations } from '../data/nav';
import { cities } from '../data/cities';
const year = new Date().getFullYear();
const locHalf = Math.ceil(locations.length / 2);
const locationsCol1 = locations.slice(0, locHalf);
const locationsCol2 = locations.slice(locHalf);
---
<footer class="site-footer">
  <div class="footer-gfx" aria-hidden="true"></div>
  <div class="container">
    <div class="footer-grid footer-grid-new">
      <div class="footer-col footer-brand">
        <a href="/" class="logo logo-image" style="margin-bottom:14px;">
          <img src="/images/huzaifa-logo.webp" alt="Huzaifa Local SEO" width="210" height="70" loading="lazy" decoding="async" />
        </a>
        <p style="max-width:280px; font-size:0.92rem;">Based in Karachi, we help businesses across Pakistan get found on Google through local SEO, Google Business Profile optimization, website design and content that brings real customers.</p>
      </div>
      <div class="footer-col">
        <h3>Our Services</h3>
        <ul>
          {services.map((s) => <li><a href={s.href}>{s.title}</a></li>)}
        </ul>
      </div>
      <div class="footer-col">
        <h3>Popular Locations</h3>
        <div class="footer-locations-split">
          <ul>
            {locationsCol1.map((l) => <li><a href={l.href}>{l.title}</a></li>)}
          </ul>
          <ul>
            {locationsCol2.map((l) => <li><a href={l.href}>{l.title}</a></li>)}
            <li><a href="/zip-codes/">Zip Codes</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-col">
        <h3>Quick Links</h3>
        <ul>
          <li><a href="/about-us/">About Us</a></li>
          <li><a href="/portfolio/">Portfolio</a></li>
          <li><a href="/faq/">FAQs</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/terms-and-conditions/">Terms & Conditions</a></li>
          <li><a href="/sitemap/">Sitemap</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} Huzaifa Local SEO. All rights reserved.</span>
      <div class="footer-bottom-links">
        <a href="/services/">Local SEO</a>
        <a href="/services/gmb-optimization/">Google Business Profile</a>
        <a href="/services/website-design/">Website Design</a>
        <a href="/services/content-writing/">Content Writing</a>
        <a href="/locations/">Pakistan</a>
      </div>
    </div>
  </div>
</footer>
