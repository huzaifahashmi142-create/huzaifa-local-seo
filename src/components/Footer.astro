---
import { services, locations } from '../data/nav';
import { cities } from '../data/cities';
const year = new Date().getFullYear();
const locHalf = Math.ceil(locations.length / 2);
const locationsCol1 = locations.slice(0, locHalf);
const locationsCol2 = locations.slice(locHalf);
---
<footer class="site-footer">
  <div class="footer-gfx" aria-hidden="true"></div>
  <div class="container">
    <div class="footer-grid footer-grid-new">
      <div class="footer-col footer-brand">
        <a href="/" class="logo logo-image" style="margin-bottom:14px;">
          <img src="/images/huzaifa-logo.webp" alt="Huzaifa Local SEO" width="220" height="73" />
        </a>
        <p style="max-width:280px; font-size:0.92rem;">We help businesses across Pakistan get found on Google through local SEO, Google Business Profile optimization, website design and content that brings real customers.</p>
        <div class="footer-social">
          <a href="#" aria-label="Facebook"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z"/></svg></a>
          <a href="#" aria-label="LinkedIn"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3V9zm7 0h3.8v1.7h.1c.5-1 1.9-2 3.9-2 4.2 0 5 2.7 5 6.3V21h-4v-5.3c0-1.3 0-2.9-1.8-2.9-1.8 0-2 1.4-2 2.8V21h-4V9z"/></svg></a>
          <a href="#" aria-label="Instagram"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 2 .2 2.5.5.6.2 1 .5 1.5 1 .4.4.7.9 1 1.5.2.4.4 1.2.5 2.5.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 2-.5 2.5-.2.6-.5 1-1 1.5-.4.4-.9.7-1.5 1-.4.2-1.2.4-2.5.5-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-2-.2-2.5-.5-.6-.2-1-.5-1.5-1-.4-.4-.7-.9-1-1.5-.2-.4-.4-1.2-.5-2.5C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.2-2 .5-2.5.2-.6.5-1 1-1.5.4-.4.9-.7 1.5-1 .4-.2 1.2-.4 2.5-.5C9.4 2.2 9.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.7.1-1 0-1.6.2-1.9.3-.5.2-.8.4-1.2.8-.4.4-.6.7-.8 1.2-.1.3-.3.9-.3 1.9C3 9.5 3 9.9 3 13s0 3.5.1 4.7c0 1 .2 1.6.3 1.9.2.5.4.8.8 1.2.4.4.7.6 1.2.8.3.1.9.3 1.9.3 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1 0 1.6-.2 1.9-.3.5-.2.8-.4 1.2-.8.4-.4.6-.7.8-1.2.1-.3.3-.9.3-1.9.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c0-1-.2-1.6-.3-1.9-.2-.5-.4-.8-.8-1.2a3.2 3.2 0 0 0-1.2-.8c-.3-.1-.9-.3-1.9-.3-1.2-.1-1.6-.1-4.7-.1zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 1.8a3.2 3.2 0 1 0 0 6.4 3.2 3.2 0 0 0 0-6.4zm5.2-2a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0z"/></svg></a>
          <a href="#" aria-label="YouTube"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.2-.4-4.6a3 3 0 0 0-2.1-2.1C19 5 12 5 12 5s-7 0-8.5.3A3 3 0 0 0 1.4 7.4C1 8.8 1 12 1 12s0 3.2.4 4.6a3 3 0 0 0 2.1 2.1C5 19 12 19 12 19s7 0 8.5-.3a3 3 0 0 0 2.1-2.1C23 15.2 23 12 23 12zM9.8 15.5V8.5L15.8 12l-6 3.5z"/></svg></a>
        </div>
      </div>
      <div class="footer-col">
        <h3>Our Services</h3>
        <ul>
          {services.map((s) => <li><a href={s.href}>{s.title}</a></li>)}
        </ul>
      </div>
      <div class="footer-col">
        <h3>Popular Locations</h3>
        <div class="footer-locations-split">
          <ul>
            {locationsCol1.map((l) => <li><a href={l.href}>{l.title}</a></li>)}
          </ul>
          <ul>
            {locationsCol2.map((l) => <li><a href={l.href}>{l.title}</a></li>)}
            <li><a href="/zip-codes/">Zip Codes</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-col">
        <h3>Quick Links</h3>
        <ul>
          <li><a href="/about-us/">About Us</a></li>
          <li><a href="/portfolio/">Portfolio</a></li>
          <li><a href="/faq/">FAQs</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/terms-and-conditions/">Terms & Conditions</a></li>
          <li><a href="/sitemap/">Sitemap</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} Huzaifa Local SEO. All rights reserved.</span>
      <div class="footer-bottom-links">
        <a href="/services/">Local SEO</a>
        <a href="/services/gmb-optimization/">Google Business Profile</a>
        <a href="/services/website-design/">Website Design</a>
        <a href="/services/content-writing/">Content Writing</a>
        <a href="/locations/">Pakistan</a>
      </div>
    </div>
  </div>
</footer>
