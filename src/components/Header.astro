---
import { mainNav } from '../data/nav';
const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo logo-image" aria-label="Huzaifa Local SEO home">
      <img src="/images/huzaifa-logo.webp" alt="Huzaifa Local SEO" width="220" height="73" />
    </a>

    <nav class="main-nav" aria-label="Primary">
      {mainNav.map((item) => (
        item.children ? (
          <div class="has-dropdown">
            <a href={item.href} class={isActive(item.href) ? 'active' : ''}>{item.title}</a>
            <span class="dropdown-toggle" tabindex="0" aria-label={`Show ${item.title} menu`}>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
            </span>
            <div class="dropdown">
              {item.children.map((child) => (
                <a href={child.href}>{child.title}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.href} class={isActive(item.href) ? 'active' : ''}>{item.title}</a>
        )
      ))}
    </nav>

    <div class="header-cta">
      <a href="tel:+923198652203" class="btn btn-white">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        (0319) 865 2203
      </a>
    </div>

    <button class="nav-toggle" aria-label="Toggle menu" onclick="document.body.classList.toggle('nav-open')">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
  </div>

  <div class="mobile-nav">
    <a href="/">Home</a>
    <a href="/about-us/">About</a>
    <details>
      <summary>Services</summary>
      <a href="/services/">All Services</a>
      <a href="/services/on-page-seo/">On-Page SEO</a>
      <a href="/services/off-page-seo/">Off-Page SEO</a>
      <a href="/services/gmb-optimization/">GMB Optimization</a>
      <a href="/services/website-design/">Website Design</a>
      <a href="/services/website-maintenance/">Website Maintenance</a>
      <a href="/services/content-writing/">Content Writing</a>
    </details>
    <a href="/portfolio/">Portfolio</a>
    <a href="/locations/">Locations</a>
    <a href="/faq/">FAQ</a>
    <a href="/contact/">Contact</a>
    <a href="tel:+923198652203" class="btn btn-white btn-block" style="margin-top:14px;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      (0319) 865 2203
    </a>
  </div>
</header>
