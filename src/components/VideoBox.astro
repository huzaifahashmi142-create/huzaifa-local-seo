---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  videoUrl?: string;
  title: string;
}
const { videoUrl, title } = Astro.props;
const isFile = !!videoUrl && /\.(mp4|webm|mov)$/i.test(videoUrl);

// Poster frame lives at /videos/posters/<same-name>.webp. If it has not been generated yet,
// a plain play tile is shown instead. Either way, no video file is requested until the visitor interacts.
let poster: string | undefined;
if (isFile) {
  const base = path.basename(videoUrl!).replace(/\.[^.]+$/, '');
  const rel = `/videos/posters/${base}.webp`;
  if (fs.existsSync(path.join(process.cwd(), 'public', rel))) poster = rel;
}
---
<div class="case-video">
  {videoUrl ? (
    isFile ? (
      <button type="button" class="video-preview" data-video-src={videoUrl} aria-label={`Play preview of ${title}`}>
        {poster ? (
          <img class="video-poster" src={poster} alt={`${title} website preview`} width="640" height="400" loading="lazy" decoding="async" />
        ) : (
          <span class="case-video-placeholder" aria-hidden="true">
            <span class="case-video-play">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </span>
            <span>Hover or tap to play</span>
          </span>
        )}
        <span class="video-play-badge" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </span>
      </button>
    ) : (
      <iframe
        src={videoUrl}
        title={`${title} video`}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    )
  ) : (
    <div class="case-video-placeholder" aria-hidden="true">
      <span class="case-video-play">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      </span>
      <span>Video Placeholder</span>
    </div>
  )}
</div>

<style is:global>
  .video-preview {
    position: absolute; inset: 0; width: 100%; height: 100%;
    padding: 0; border: 0; background: transparent; cursor: pointer; display: block; color: inherit;
  }
  .video-preview .video-poster { width: 100%; height: 100%; object-fit: cover; display: block; }
  .video-preview video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .video-play-badge {
    position: absolute; right: 12px; bottom: 12px; width: 36px; height: 36px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: rgba(15,22,38,0.7); color: #fff; border: 1px solid rgba(255,255,255,0.25);
    transition: opacity 0.2s ease;
  }
  .video-preview.is-playing .video-play-badge { opacity: 0; }
  .video-preview:focus-visible { outline: 2px solid var(--blue-400); outline-offset: -2px; }
</style>

<script>
  // Nothing loads or plays on page load. A video is created only on desktop hover or on click/tap.
  const win = window as any;
  if (!win.__videoPreviewInit) {
    win.__videoPreviewInit = true;
    const conn = (navigator as any).connection;
    const saveData = !!(conn && (conn.saveData || /(^|-)2g$/.test(conn.effectiveType || '')));

    const start = (box: HTMLElement) => {
      let video = box.querySelector('video') as HTMLVideoElement | null;
      if (!video) {
        video = document.createElement('video');
        video.muted = true;
        video.loop = true;
        video.playsInline = true;
        video.preload = 'metadata';
        video.setAttribute('aria-hidden', 'true');
        video.src = box.dataset.videoSrc || '';
        box.appendChild(video);
      }
      box.classList.add('is-playing');
      video.play().catch(() => {});
    };
    const stop = (box: HTMLElement) => {
      const video = box.querySelector('video') as HTMLVideoElement | null;
      if (video) { video.pause(); video.remove(); }
      box.classList.remove('is-playing');
    };

    document.addEventListener('pointerenter', (e) => {
      const box = (e.target as HTMLElement)?.closest?.('.video-preview') as HTMLElement | null;
      if (box && (e as PointerEvent).pointerType === 'mouse' && !saveData) start(box);
    }, true);
    document.addEventListener('pointerleave', (e) => {
      const box = (e.target as HTMLElement)?.closest?.('.video-preview') as HTMLElement | null;
      if (box && (e as PointerEvent).pointerType === 'mouse') stop(box);
    }, true);
    document.addEventListener('click', (e) => {
      const box = (e.target as HTMLElement)?.closest?.('.video-preview') as HTMLElement | null;
      if (!box) return;
      box.classList.contains('is-playing') && box.querySelector('video') && !(e as PointerEvent).pointerType?.match(/mouse/) ? stop(box) : start(box);
    });
  }
</script>
