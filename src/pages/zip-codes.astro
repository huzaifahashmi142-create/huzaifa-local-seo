---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PlatformMarquee from '../components/PlatformMarquee.astro';
import CtaBand from '../components/CtaBand.astro';
import { cities } from '../data/cities';

const title = 'Postal / Zip Codes We Cover in Pakistan | Huzaifa Local SEO';
const description = 'Browse the postal and zip code areas across Karachi, Lahore, Islamabad, Faisalabad, Multan, Peshawar, Quetta and Sialkot where we provide local SEO services.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://huzaifalocalseo.com/' },
    { '@type': 'ListItem', position: 2, name: 'Zip Codes', item: 'https://huzaifalocalseo.com/zip-codes/' },
  ],
};
---
<BaseLayout title={title} description={description} path="/zip-codes/" schema={schema}>
  <PageHero
    crumbs={[{label:'Home', href:'/'}, {label:'Zip Codes'}]}
    eyebrow="Coverage Area"
    title="Postal and zip codes we cover across Pakistan"
    subtitle="A full list of the postal code areas we serve within each of our 8 covered cities. If your area isn't listed, reach out and we'll confirm coverage."
    ctaPrimary={{label: 'Get a Free Audit', href: '/contact/'}}
  />

  <PlatformMarquee />

  {cities.map((c: any) => c.zipCodes && (
    <section class="section section-tight">
      <div class="container">
        <div class="section-head">
          <h2>{c.name} Postal Codes</h2>
          <p>Local SEO and Google Business Profile optimization for businesses across these {c.name} postal code areas.</p>
        </div>
        <div class="grid grid-4" style="gap:14px;">
          {c.zipCodes.map((z: any) => (
            <a href={`/locations/${c.slug}/`} class="card zip-card">
              <div class="zip-card-top">
                <span class="zip-code">{z.code}</span>
                <span class="zip-card-pin">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
                </span>
              </div>
              <h3>{z.area}</h3>
              <p>{c.name}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <CtaBand
    title="Don't See Your Area Listed?"
    body="We work across many more neighbourhoods and postal areas than we can list here. Get in touch and we'll confirm coverage for your exact location."
    ctaLabel="Get a Free Audit"
    secondaryLabel="View Our Locations"
    secondaryHref="/locations/"
  />
</BaseLayout>
