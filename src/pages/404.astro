---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page Not Found | Huzaifa Local SEO';
const description = 'The page you are looking for could not be found.';
---
<BaseLayout title={title} description={description} path="/404/">
  <section class="section" style="padding-top:120px; padding-bottom:120px; text-align:center;">
    <div class="container">
      <span class="badge">404</span>
      <h1 style="margin-top:16px;">We couldn't find that page</h1>
      <p style="max-width:480px; margin:0 auto 28px;">The page you're looking for may have been moved or no longer exists. Try the homepage, or explore our services and locations below.</p>
      <div class="btn-row" style="justify-content:center;">
        <a href="/" class="btn btn-primary">Back to Homepage</a>
        <a href="/services/" class="btn btn-outline">View Services</a>
        <a href="/locations/" class="btn btn-outline">View Locations</a>
      </div>
    </div>
  </section>
</BaseLayout>
