---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import PlatformMarquee from '../components/PlatformMarquee.astro';
import VideoBox from '../components/VideoBox.astro';
import { websiteShowcase } from '../data/websiteShowcase';

const title = 'Portfolio & Case Studies | Huzaifa Local SEO';
const description = 'Real local SEO case studies across construction, dental, automobile, restaurant, real estate and other Pakistani businesses: see the work and the results.';

const directAnswer = 'Huzaifa Local SEO has worked on local search visibility for seven businesses across Pakistan, covering construction, dental care, automobile repair, furniture retail, restaurants, real estate and beauty salons. Each case study on this page states the starting problem, the specific work carried out on the Google Business Profile or website, and the outcome that followed.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://huzaifalocalseo.com/' },
      { '@type': 'ListItem', position: 2, name: 'Portfolio', item: 'https://huzaifalocalseo.com/portfolio/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What kind of local SEO work does this portfolio cover?',
        acceptedAnswer: { '@type': 'Answer', text: directAnswer },
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Huzaifa',
    jobTitle: 'Founder, Huzaifa Local SEO',
    worksFor: { '@type': 'Organization', name: 'Huzaifa Local SEO' },
    knowsAbout: ['Local SEO', 'Google Business Profile Optimization', 'On-Page SEO', 'Off-Page SEO'],
  },
];
---
<BaseLayout title={title} description={description} path="/portfolio/" schema={schema}>
  <PageHero
    crumbs={[{label:'Home', href:'/'}, {label:'Portfolio'}]}
    eyebrow="Our Portfolio"
    title="Case studies from real businesses across Pakistan"
    summary="This page shows real examples of local businesses we helped show up better on Google. It is for owners of small and medium businesses, such as clinics, salons, restaurants and shops, who want to see results before they hire us. There are seven examples from cities like Karachi, Lahore and Islamabad, and each one says what we did and what changed."
    subtitle="Seven examples of the industries we work with: construction, healthcare, automobile, food, real estate and more, and the kind of local SEO work that moved each one forward."
    ctaPrimary={{label: 'Get a Free Audit', href: '/contact/'}}
  />

  <PlatformMarquee />

  <section class="section section-tight">
    <div class="container">
      <div class="answer-box">
        <span class="eyebrow">Quick Answer</span>
        <h2>What does this portfolio cover?</h2>
        <p class="answer-lead">{directAnswer}</p>
      </div>
    </div>
  </section>


  <section class="section website-showcase-section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow showcase-eyebrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
          Websites We&rsquo;ve Built
        </span>
        <h2>A look at the websites behind these businesses</h2>
        <p>Beyond local SEO, we also design and build the websites these businesses run on: fast, mobile-friendly, and built to convert visitors into customers.</p>
      </div>

      <div class="showcase-panel">
        <div class="case-grid">
          {websiteShowcase.map((w) => (
            <article id={w.slug} class="case-card showcase-card">
              <VideoBox videoUrl={w.videoUrl} title={w.name} />
              <div class="case-body case-body-simple">
                <p>{w.name}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <style>
    .website-showcase-section { padding-top: 24px; padding-bottom: 24px; }
    .showcase-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 7px;
    }
    .showcase-panel {
      margin-top: 44px;
      padding: 36px;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 28px;
      background: linear-gradient(160deg, #1f2a46, #18223c);
    }
    .showcase-panel .case-card {
      background: linear-gradient(160deg, #1f2a46, #18223c);
      border-color: rgba(255,255,255,0.12);
    }
    .showcase-panel .case-body-simple { border-top-color: rgba(255,255,255,0.1); }
    .showcase-panel .case-body-simple p { color: #f1f5f9; }
    .showcase-card { transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease; }
    .showcase-card:hover { transform: translateY(-5px); }
    @media (max-width: 640px) {
      .showcase-panel { padding: 20px; border-radius: 22px; margin-top: 32px; }
    }
  </style>

  <section class="section journey-section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">How These Results Happen</span>
        <h2>Every case study follows the same journey</h2>
        <p>No two businesses are the same, but the work behind each result on this page follows a consistent, repeatable process: not guesswork, and not a different approach every time.</p>
      </div>

      <div class="journey-stage" aria-hidden="true">
        <svg class="journey-svg" viewBox="0 0 900 220" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="journey-line" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#22d3ee"/>
              <stop offset="100%" stop-color="#6366f1"/>
            </linearGradient>
            <pattern id="journey-grid" width="24" height="24" patternUnits="userSpaceOnUse">
              <circle cx="1.1" cy="1.1" r="1.1" fill="#3b82f6" fill-opacity="0.18"/>
            </pattern>
            <filter id="journey-glow" x="-100%" y="-100%" width="300%" height="300%">
              <feGaussianBlur stdDeviation="5" result="blur"/>
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
          </defs>
          <rect x="0" y="0" width="900" height="220" fill="url(#journey-grid)"/>
          <path d="M 90 110 C 250 20, 350 200, 450 110 S 650 20, 810 110" fill="none" stroke="url(#journey-line)" stroke-width="2.5" stroke-linecap="round"/>
          {[
            { x: 90, y: 110, label: 'Search', icon: 'M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM21 21l-4.3-4.3' },
            { x: 310, y: 158, label: 'Map Pack', icon: 'M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21zM12 9.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z' },
            { x: 530, y: 62, label: 'Website', icon: 'M3 4h18v16H3zM3 9h18M8 4v5' },
            { x: 730, y: 158, label: 'Reviews', icon: 'M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z' },
            { x: 810, y: 110, label: 'Customer', icon: 'M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9zM4 21c1.5-4.5 5-6.5 8-6.5s6.5 2 8 6.5' },
          ].map((n) => (
            <g>
              <circle cx={n.x} cy={n.y} r="26" fill="#131b2e" stroke="#3b82f6" stroke-width="1.5" filter="url(#journey-glow)"/>
              <svg x={n.x - 11} y={n.y - 11} width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2"><path d={n.icon}/></svg>
              <text x={n.x} y={n.y + 44} text-anchor="middle" font-size="13" font-weight="700" fill="#0b1324" font-family="inherit">{n.label}</text>
            </g>
          ))}
        </svg>
      </div>
    </div>
  </section>

  <style>
    .journey-section { padding-top: 16px; padding-bottom: 16px; }
    .journey-stage {
      max-width: 900px;
      margin: 44px auto 0;
      border: 1px solid var(--border-subtle);
      border-radius: 24px;
      background: linear-gradient(160deg, var(--navy-800), var(--navy-850));
      overflow: hidden;
      padding: 40px 0 56px;
    }
    .journey-svg { width: 100%; height: auto; display: block; }
    @media (max-width: 640px) {
      .journey-stage { padding: 28px 0 40px; }
    }
  </style>

  <section class="section trust-message-section">
    <div class="container">
      <div class="trust-message">
        <svg class="trust-quote-mark" width="42" height="34" viewBox="0 0 42 34" fill="none" aria-hidden="true">
          <path d="M11.5 0C5.2 3.4 0 10.3 0 18.2 0 26.7 5.9 33 13.6 33c6.1 0 10.6-4.6 10.6-10.5 0-5.5-3.9-9.6-9.1-9.6-1 0-1.9.1-2.5.4C13.5 8.4 17.8 3.7 23.6 0l-12.1 0zM29.4 0c-6.3 3.4-11.5 10.3-11.5 18.2 0 8.5 5.9 14.8 13.6 14.8 6.1 0 10.6-4.6 10.6-10.5 0-5.5-3.9-9.6-9.1-9.6-1 0-1.9.1-2.5.4C31.4 8.4 35.7 3.7 41.5 0l-12.1 0z" fill="currentColor"/>
        </svg>

        <blockquote>
          <p>I&rsquo;ve spent the last several years working directly with local businesses in Pakistan, starting with a handful of clients and growing into the case studies you see on this page. That history is what shaped how we work: audit first, research what your customers actually search for, fix your Google Business Profile and website, then track results every month and show you exactly what changed.</p>
          <p>No guaranteed #1 rankings, no shortcuts, just the same honest process applied to every business we take on.</p>
        </blockquote>

        <footer class="trust-message-signature">
          <div class="trust-avatar" aria-hidden="true">HLS</div>
          <div>
            <div class="trust-name">Huzaifa: Founder, Huzaifa Local SEO</div>
            <div class="trust-role">Hands-on local SEO &amp; Google Business Profile optimization for businesses across Pakistan</div>
          </div>
        </footer>
      </div>
    </div>
  </section>

  <style>
    .trust-message-section { padding-top: 48px; padding-bottom: 48px; }
    .trust-message {
      position: relative;
      max-width: 840px;
      margin: 0 auto;
      background: linear-gradient(160deg, var(--navy-800), var(--navy-850) 60%, var(--navy-800));
      border: 1px solid var(--border-subtle);
      border-radius: 28px;
      padding: 64px 68px;
      overflow: hidden;
      box-shadow: 0 24px 60px rgba(0,0,0,0.25);
    }
    .trust-message::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 500px 260px at 0% 0%, rgba(34,211,238,0.12), transparent 65%),
                  radial-gradient(ellipse 500px 260px at 100% 100%, rgba(99,102,241,0.14), transparent 65%);
      pointer-events: none;
    }
    .trust-quote-mark {
      position: relative;
      color: var(--blue-500);
      opacity: 0.55;
      margin-bottom: 22px;
    }
    .trust-message blockquote {
      position: relative;
      margin: 0;
      font-size: 1.12rem;
      line-height: 1.95;
      color: var(--text-secondary);
      letter-spacing: 0.1px;
    }
    .trust-message blockquote p { margin-bottom: 24px; }
    .trust-message blockquote p:last-child { margin-bottom: 0; color: var(--text-primary); font-weight: 500; }
    .trust-message-signature {
      position: relative;
      display: flex;
      align-items: center;
      gap: 18px;
      margin-top: 44px;
      padding-top: 32px;
      border-top: 1px solid var(--border-subtle);
    }
    .trust-avatar {
      width: 56px; height: 56px;
      flex-shrink: 0;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      background: var(--gradient-primary);
      color: #fff;
      font-weight: 700;
      font-size: 0.84rem;
      letter-spacing: 0.03em;
      box-shadow: 0 6px 18px rgba(59,130,246,0.35);
    }
    .trust-name { font-weight: 600; color: var(--text-primary); font-size: 1rem; margin-bottom: 5px; letter-spacing: 0.01em; }
    .trust-role { font-size: 0.87rem; color: var(--text-muted); line-height: 1.5; }
    @media (max-width: 640px) {
      .trust-message { padding: 40px 28px; }
      .trust-message-signature { align-items: flex-start; }
    }
  </style>

  <CtaBand
    title="Want Results Like These for Your Business?"
    body="Every business is different, but the approach is the same: an honest audit, real search-intent research, and work that's actually tracked and reported."
    ctaLabel="Get a Free SEO Audit"
    secondaryLabel="View Our Services"
    secondaryHref="/services/"
  />
</BaseLayout>
